# Copy to apps/api/.env for standalone (non-docker) local dev.
# See root .env.example for the full annotated list with comments.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
MONGO_URI=mongodb://localhost:27017/pawball
# Optional — leave blank / delete to run without Redis (background workers off).
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# CV runs in-process (modules/capture/cv.service.ts) via the Gemini REST API.
# Free key: https://aistudio.google.com/app/apikey. Unset -> mock CV result.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Fantasy card artwork (modules/artwork/artwork.service.ts) via fal.ai's
# flux/dev/image-to-image REST API. Key: https://fal.ai/dashboard/keys.
# Unset -> the card keeps the original capture photo as its artwork.
FAL_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
