# Copy to services/ai/.env for standalone (non-docker) local dev.

# CV pipeline — Gemini Vision (app/services/vision_cv.py). Free key at
# https://aistudio.google.com/app/apikey. If this is unset, POST /cv/analyze
# returns a labelled mock CvAnalysisResult (mock:true) so the capture
# pipeline still runs without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Image generation (placeholder provider composites the card locally).
IMAGE_GEN_PROVIDER=placeholder
IMAGE_GEN_FALLBACK_CHAIN=placeholder
COMFYUI_HOST=http://localhost:8188
SDXL_COMFYUI_HOST=http://localhost:8188

# Only needed if the imagegen placeholder uploads composited cards.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
