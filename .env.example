# PawBall Chronicles — Environment Variables
# Copy this file to .env (root) for docker-compose, and/or to each
# app's own .env for standalone local dev (apps/web/.env.local,
# apps/api/.env, services/ai/.env). See README.md "Environment Variables"
# section for which variables each service actually needs.

# ---- Shared / Cloudinary (used by apps/api AND services/ai) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- apps/api ----
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/pawball
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# ---- apps/web ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- services/ai ----
IMAGE_GEN_PROVIDER=placeholder
IMAGE_GEN_FALLBACK_CHAIN=placeholder
COMFYUI_HOST=http://localhost:8188
SDXL_COMFYUI_HOST=http://localhost:8188
