# PawBall Chronicles — Environment Variables
# Copy this file to .env (root) for docker-compose, and/or to each app's own
# .env for standalone local dev (apps/web/.env.local, apps/api/.env).

# ---- Cloudinary (apps/api — original photo storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- apps/api ----
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/pawball
# Optional — leave blank / delete to run without Redis (background workers off).
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORS_ORIGIN=http://localhost:3000
# CV runs in-process (modules/capture/cv.service.ts) via the Gemini REST API.
# Free key: https://aistudio.google.com/app/apikey. Unset -> mock CV result.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ---- apps/web ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
